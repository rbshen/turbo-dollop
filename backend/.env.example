FMP_API_KEY=
# Pauses all live FMP calls when set to false -- the app runs entirely
# cache-only (serves whatever's already cached, however stale, rather than
# hanging or erroring). Read once at process start: toggling this requires
# a backend restart to take effect, not a live/runtime toggle. Defaults to
# true (unset also means true). See CLAUDE.md's "Pausing the FMP
# subscription" section for what degrades and what stays unaffected.
FMP_ENABLED=true
DATABASE_PATH=fathom.db
CACHE_STALENESS_DAYS=7
CACHE_RETENTION_DAYS=180
ALPHA_VANTAGE_API_KEY=
# Required by SEC EDGAR's fair-use policy: identify this app with a real
# contact email, e.g. "Fathom Fundamentals Screener you@yourdomain.com"
SEC_EDGAR_USER_AGENT=
