FMP_API_KEY=
# FMP on/off is NOT an env flag any more (FMP_ENABLED / INSIDER_ACTIVITY_ENABLED
# were removed 2026-09-24): per-group toggles, the master switch and your FMP plan
# live in the DB -- Settings > Status, or `python -m pipeline.data_groups`.
# Gates only GET /api/config/cron-health's reporting and the frontend
# CronHealthBanner -- CronRunLog rows keep being written regardless, so
# history isn't lost while this is off. Useful for muting cron-health
# surfacing during an extended FMP pause. Read once at
# process start. Defaults to true (unset also means
# true). See CLAUDE.md's "Cron job heartbeat / health monitoring" section.
CRON_HEALTH_ENABLED=true
DATABASE_PATH=fathom.db
CACHE_STALENESS_DAYS=7
CACHE_RETENTION_DAYS=180
# Required by SEC EDGAR's fair-use policy: identify this app with a real
# contact email, e.g. "Fathom Fundamentals Screener you@yourdomain.com"
SEC_EDGAR_USER_AGENT=
